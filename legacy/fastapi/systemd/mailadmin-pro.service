[Unit]
Description=MailAdmin Pro Dashboard
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/mailadmin-pro
EnvironmentFile=/opt/mailadmin-pro/.env
ExecStart=/opt/mailadmin-pro/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8095
Restart=always
RestartSec=3
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/mailadmin-pro

[Install]
WantedBy=multi-user.target

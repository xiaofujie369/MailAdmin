[Unit]
Description=MailAdmin Pro Dashboard
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/mailadmin-pro
EnvironmentFile=/opt/mailadmin-pro/.env
ExecStart=/opt/mailadmin-pro/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8095
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

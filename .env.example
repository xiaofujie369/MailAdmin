APP_NAME=MailAdminPro
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mailadmin.example.com
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_TIMEZONE=Asia/Shanghai

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mailadmin
DB_USERNAME=mailadmin
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

MAIL_CONTAINER=mailserver
MAIL_DOMAIN=example.com
MAIL_HOSTNAME=mail.example.com

COLLECTOR_INTERVAL_SECONDS=60
LOG_TAIL_LIMIT=50000
QUEUE_ALERT_THRESHOLD=100
BOUNCE_RATE_ALERT_THRESHOLD=10
DEFERRED_RATE_ALERT_THRESHOLD=20
